# Source development only. Saved UI settings take precedence.
# Use either an API key or a compatible-service token, never both.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_CODE_MODEL=sonnet
# ANTHROPIC_MODEL=your-provider-model

# Optional PKULAW connections. Only complete URL/token pairs are enabled.
# PKULAW_ACCESS_TOKEN=
# PKULAW_LAW_SEARCH_URL=
# PKULAW_LAW_KEYWORD_URL=
# PKULAW_CASE_SEMANTIC_URL=
# PKULAW_LAW_ITEM_URL=
# PKULAW_CITATION_VALIDATOR_URL=

# Optional isolated data directory and source-server port.
# COMPLIANCE_DATA_DIR=D:/compliance-local-data
# COMPLIANCE_PORT=8000
# 内置 LightRAG：仅查询向量调用远程 API，不在用户端建库
COMPLIANCE_RAG_ENABLED=false
COMPLIANCE_EMBEDDING_URL=https://router.tumuer.me/v1/embeddings
COMPLIANCE_EMBEDDING_API_KEY=
